    <collision>
      <origin xyz="0 0 0.4315" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.863"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LINK 5 ==================== -->
  <link name="link5">
    <inertial>
      <origin xyz="0 0 0.4315" rpy="0 0 0"/>
      <mass value="31.9457"/>
      <inertia ixx="2.002649" iyy="2.002649" izz="0.039932" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>

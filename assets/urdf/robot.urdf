<?xml version="1.0"?>
<robot name="7dof_manipulator">
  <!-- 材料定义 -->
  <material name="blue">
    <color rgba="0.2 0.5 0.8 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <!-- ==================== BASE LINK ==================== -->
  <!-- <link name="base_link">
    <inertial>
